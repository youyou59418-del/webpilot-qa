# Qwen2.5 14B GPTQ-Int4 profile for the AutoDL RTX 4090 (24GB).
# Use with: set -a; source config/model_profiles/qwen2.5-14b-gptq-int4-local.env; set +a
# The local model path prevents a restart from downloading weights again.
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=local-webpilot-only
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-GPTQ-Int4
LLM_TIMEOUT_S=180

VLLM_MODEL=/root/autodl-tmp/models/Qwen2.5-14B-Instruct-GPTQ-Int4
VLLM_SERVED_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct-GPTQ-Int4
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.80
